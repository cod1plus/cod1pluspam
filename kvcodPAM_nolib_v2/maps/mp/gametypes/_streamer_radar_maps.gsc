overview(name, x, y, span, spanY)
{
	c = spawnstruct();
	c.image = "gfx/streamer/overview/" + name + ".jpg";
	c.x = x;
	c.y = y;
	c.span = span;		// world width of the image
	c.spanY = spanY;	// world height of the image
	c.up = 90;
	return c;
}
